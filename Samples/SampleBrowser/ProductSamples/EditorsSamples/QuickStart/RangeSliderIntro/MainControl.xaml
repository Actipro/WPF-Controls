									<editors:RangeSlider.MarkElements>
										<editors:RangeSliderMark Value="0" Content="12 AM" />
										<editors:RangeSliderMark Value="720" Content="12 PM" />
										<editors:RangeSliderMark Value="1440" Content="12 AM" />
									</editors:RangeSlider.MarkElements>
								</editors:RangeSlider>

								<TextBlock Grid.Row="1" Grid.Column="0" Text="Arrive" />
