								<TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{Binding ElementName=flightSearchLayoverDuration, Path=RangeEnd, Converter={StaticResource TotalMinutesToElapsedTimeConverter}}" />
							</Grid>
						</StackPanel>
						<StackPanel Margin="0,0,0,20">
							<TextBlock Margin="0,0,0,10" FontSize="{DynamicResource {x:Static themes:AssetResourceKeys.LargeFontSizeDoubleKey}}" FontWeight="DemiBold" Text="Departing Flight" />
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="75" />
									<ColumnDefinition Width="*" />
