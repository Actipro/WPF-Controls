									<editors:RangeSlider.MarkElements>
										<editors:RangeSliderMark Value="0" Content="12 AM" />
										<editors:RangeSliderMark Value="720" Content="12 PM" />
										<editors:RangeSliderMark Value="1440" Content="12 AM" />
									</editors:RangeSlider.MarkElements>
								</editors:RangeSlider>
							</Grid>
						</StackPanel>
						<StackPanel Margin="0,0,0,20">
							<TextBlock Margin="0,0,0,10" FontSize="{DynamicResource {x:Static themes:AssetResourceKeys.LargeFontSizeDoubleKey}}" FontWeight="DemiBold" Text="Return Flight" />
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="75" />
