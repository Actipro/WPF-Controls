				<!--
				SAMPLE: Flight search
				-->
				<sampleBrowser:LabeledCardControl Label="RangeSlider in various configurations as part of a flight search form.">
					<sampleBrowser:LabeledCardControl.Resources>
						<local:TotalMinutesToElapsedTimeConverter x:Key="TotalMinutesToElapsedTimeConverter" />
						<local:TotalMinutesToTimeOfDayConverter x:Key="TotalMinutesToTimeOfDayConverter" />
					</sampleBrowser:LabeledCardControl.Resources>
					<StackPanel>
						<StackPanel Margin="0,0,0,20">
							<TextBlock FontSize="{DynamicResource {x:Static themes:AssetResourceKeys.ExtraLarge3FontSizeDoubleKey}}" Text="Flight Search" />
							<TextBlock FontSize="{DynamicResource {x:Static themes:AssetResourceKeys.ExtraLarge2FontSizeDoubleKey}}" Text="Nashville, TN (BNA) - Maui, HI (OGG)" />
						</StackPanel>
						<StackPanel Margin="0,0,0,20">
							<TextBlock Margin="0,0,0,10" FontSize="{DynamicResource {x:Static themes:AssetResourceKeys.LargeFontSizeDoubleKey}}" FontWeight="DemiBold" Text="Max Flight Duration" />
							<DockPanel>
								<TextBlock DockPanel.Dock="Left" MinWidth="75" Text="{Binding ElementName=flightSearchMaxDuration, Path=RangeEnd, Converter={StaticResource TotalMinutesToElapsedTimeConverter}}" />
								<editors:RangeSlider x:Name="flightSearchMaxDuration" Minimum="0" Maximum="1440" StepFrequency="5" IsRanged="False" RangeEnd="120" ThumbValueBadgeDisplayKinds="None" />
							</DockPanel>
						</StackPanel>
						<StackPanel Margin="0,0,0,20">
							<TextBlock Margin="0,0,0,10" FontSize="{DynamicResource {x:Static themes:AssetResourceKeys.LargeFontSizeDoubleKey}}" FontWeight="DemiBold" Text="Layover Duration" />
